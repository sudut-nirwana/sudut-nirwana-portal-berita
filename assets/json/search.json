---
layout: null
---
[
  {% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%d %b %Y" | jsonify }},
    "category": {{ post.categories.first | default: "Berita" | jsonify }},
    "image": {{ post.image | default: "/assets/images/default.jpg" | relative_url | jsonify }},
    "snippet": {{ post.content | strip_html | strip_newlines | truncatewords: 20 | jsonify }},
    "views": {{ post.views | default: 0 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]